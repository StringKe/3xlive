{
  "name": "3xlive",
  "version": "0.1.0",
  "private": true,
  "description": "浏览器多人弹幕生存游戏",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "dotenv -- sh -c 'vp build && vp exec wrangler deploy'",
    "gen:og": "node scripts/gen-og-image.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.3.1",
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "@hono/clerk-auth": "^3.1.0",
    "hono": "4.12.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.29.1",
    "@cloudflare/workers-types": "4.20260317.1",
    "dotenv-cli": "^11.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "wrangler": "4.75.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
